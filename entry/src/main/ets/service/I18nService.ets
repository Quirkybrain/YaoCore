  private static applyResolvedLanguage(): void {
    let resolved = I18nService.preference === 'zh-Hans' ? 'zh-Hans' : 'en';
    if (I18nService.preference === 'auto') {
      let region = '';
      try {
        region = i18n.System.getSystemRegion().toUpperCase();
      } catch (error) {
        region = '';
      }
      const chineseRegions: string[] = ['CN', 'TW', 'HK', 'MO'];
      resolved = chineseRegions.indexOf(region) >= 0 ? 'zh-Hans' : 'en';
    }
    I18nService.currentLanguage = resolved;
    try {
      i18n.System.setAppPreferredLanguage(resolved);
    } catch (error) {
    }
  }
