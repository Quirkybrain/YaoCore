import i18n from '@ohos.i18n';
import { AppStorageService } from './AppStorageService';

export type AppLanguage = 'auto' | 'zh-Hans' | 'en';

export class I18nService {
  private static currentLanguage: string = 'en';
  private static preference: AppLanguage = 'auto';

  static async initialize(): Promise<void> {
    const stored = await AppStorageService.loadLanguagePreference();
    I18nService.preference = stored === 'zh-Hans' || stored === 'en' ? stored : 'auto';
    I18nService.applyResolvedLanguage();
  }

  static async setPreference(preference: AppLanguage): Promise<void> {
    I18nService.preference = preference;
    await AppStorageService.saveLanguagePreference(preference);
    I18nService.applyResolvedLanguage();
  }

  static getPreference(): AppLanguage {
    return I18nService.preference;
  }

  static getLanguage(): string {
    return I18nService.currentLanguage;
  }

  static isChinese(): boolean {
    return I18nService.currentLanguage === 'zh-Hans';
  }

